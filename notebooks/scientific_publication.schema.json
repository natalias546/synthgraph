      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "bbox"
      ],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "page_start",
        "page_end",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "article",
            "front_matter",
            "body",
            "back_matter",
            "title",
            "subtitle",
            "abstract",
            "authors",
            "author",
            "affiliations",
            "affiliation",
            "author_note",
            "publication_metadata",
            "keywords",
            "keyword",
            "section",
            "subsection",
            "subsubsection",
            "paragraph",
            "text_block",
            "figure",
            "figure_panel",
            "caption",
            "caption_text",
            "image",
            "table",
            "table_title",
            "table_header",
            "table_row",
            "table_row_text",
            "table_cell",
            "equation",
            "equation_group",
            "list",
            "list_item",
            "references",
            "reference",
            "appendix",
            "acknowledgements",
            "funding",
            "ethics_statement",
            "data_availability",
            "code_availability",
            "author_contributions",
            "competing_interests",
            "supplementary_material",
            "contributor_list",
            "collaboration_text",
            "footnote",
            "endnote",
            "custom",
            "citation",
            "citation_year",
            "citation_venue",
            "citation_volume",
            "citation_issue",
            "citation_pages",
            "citation_identifier",
            "citation_publisher",
            "citation_edition",
            "citation_editors"
          ],
          "description": "citation_identifier uses label for identifier kind (for example DOI, ISBN, URL) and text for its literal value. citation_pages is the cited work page range; page_start/page_end always refer to the source publication."
        },
        "page_start": {
          "type": "integer",
          "minimum": 1,
          "description": "First one-based source page occupied by this element or its descendants."
        },
        "page_end": {
          "type": "integer",
          "minimum": 1,
          "description": "Last one-based source page occupied by this element or its descendants, inclusive."
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          },
          "description": "Ordered structural children. A back_matter node may contain zero or more appendix nodes; each appendix may contain nested section/subsection/subsubsection nodes. Acknowledgements is optional with zero or one paragraph. References contains reference entries; each entry preserves its source text and may contain one parsed citation."
        },
        "text": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "label_inferred": {
          "type": "boolean"
        },
        "review_required": {
          "type": "boolean"
        },
        "source": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_location"
          }
        },
        "attributes": {
          "type": "object",
          "description": "Extensible metadata for extraction rules, scientific identifiers, or domain-specific roles."
        },
        "affiliation_labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "affiliation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note_markers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "article"
              }
