{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scientific-publication:structure:1.1",
  "title": "Generic scientific publication structural schema",
  "description": "A reusable recursive structure for scientific articles, reviews, conference papers, reports, and preprints. Every structural node has inclusive one-based PDF page boundaries. Absent elements are metadata, not pageless nodes. Content may be partial if review flags and extraction limitations describe omissions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "extraction",
    "document"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ],
      "description": "New producers use 1.1; legacy 1.0 documents remain readable."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pages"
      ],
      "properties": {
        "pdf": {
          "type": "string",
          "description": "Optional PDF-specific source path retained for PDF extraction adapters."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pages": {
          "type": "integer",
          "minimum": 1
        },
        "uri": {
          "type": "string",
          "description": "Stable URL, URI, or path identifying the publication source."
        },
        "media_type": {
          "type": "string"
        },
        "page_numbering": {
          "type": "string",
          "description": "Describe logical or physical page numbering; extracted example uses one-based PDF pages."
        }
      },
      "anyOf": [
        {
          "required": [
            "uri"
          ]
        },
        {
          "required": [
            "pdf"
          ]
        }
      ]
    },
    "extraction": {
      "type": "object",
      "required": [
        "library",
        "version",
        "method",
        "limitations"
      ],
      "properties": {
        "library": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "absent_elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "page_policy": {
          "type": "string"
        }
      }
    },
    "document": {
      "type": "object",
      "properties": {
        "type": {
          "const": "article"
        }
      }
    }
  },
  "$defs": {
